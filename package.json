{
  "name": "quickassist",
  "version": "1.4.0",
  "private": true,
  "author": "tylxr59",
  "license": "MIT",
  "description": "Quick access to Home Assistant Assist from Pebble Time 2",
  "scripts": {
    "build": "pebble build",
    "test": "node --test test/*.test.js",
    "install:emery": "pebble install --emulator emery --vnc",
    "release:notes": "node tools/extract-release-notes.js"
  },
  "dependencies": {
    "@rebble/clay": "1.0.8"
  },
  "pebble": {
    "displayName": "QuickAssist",
    "uuid": "1dd94591-1fca-4521-8422-bc83719dab4a",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ],
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Type",
      "RequestId",
      "Text",
      "Ready",
      "Assistant",
      "ChunkIndex",
      "ChunkLast",
      "Url",
      "Token",
      "Pipeline",
      "IdleTimeout"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/menu-icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
